[codespell]
# Read by both the pre-commit hook and `make codespell`, so the two cannot drift.
# The skip entries include path globs such as */testdata/*, because pre-commit
# passes file paths, which a bare directory name does not match. Hidden files
# are checked, as pre-commit passes .github/ files too, so .git and .venv are
# skipped explicitly, as is this file, which lists misspellings by design.
# web/site is the built web page, with copies of the files in testdata.
check-hidden = true
skip = ./.git,./.venv,.codespellrc,./vendor,*/vendor/*,testdata,testdata/*,*/testdata/*,./out,*/out/*,./coverage.*,go.sum,./web/site
# Words codespell mistakes for misspellings, comma-separated:
#   trun - Track Fragment Run box
#   nam  - the iTunes (c)nam metadata atom
#   fiel - Field Ordering (QuickTime) box
#   alis - Alias data reference entry (QuickTime)
ignore-words-list = trun,nam,fiel,alis
